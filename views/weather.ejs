<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weather Result | Esrom</title>
    <!-- Linking the same Google Font and CSS file as the landing page -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>

    <div class="container">
        <div class="weather-card result-card">
            <p class="city-label">Current Weather in</p>
            <h1 class="city-name"><%= city %></h1>
            
            <div class="temp-display">
                <img src="<%= iconUrl %>" alt="<%= description %>" class="weather-icon">
                <span class="temp-value"><%= temp %>°C</span>
            </div>

            <p class="weather-desc"><%= description %></p>

            <a href="/" class="back-btn">Search Another City</a>
        </div>
    </div>

</body>
</html>
